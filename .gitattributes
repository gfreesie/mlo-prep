# Normalise to LF in the repo. Shell scripts and systemd units are executed on
# Linux, where CRLF line endings produce "bad interpreter" and parse failures.
* text=auto eol=lf

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.md        text eol=lf

# Copy to .env for local development. The droplet gets these from the
# systemd unit instead (deploy/mlo-prep.service), not from a file.
PORT=8788
DATABASE_PATH=./data/mloprep.sqlite
NODE_ENV=development

# Set to false to close signups outright. Signups also close automatically
# once one account exists, so this is belt-and-braces.
ALLOW_SIGNUP=true
